# Copie para .env (ou defina no painel da hospedagem).
PORT=8080
HOST=0.0.0.0
# Pasta do banco SQLite e dos backups (precisa ser um disco PERSISTENTE em produção).
DATA_DIR=./data
NODE_ENV=production
# 1 quando houver proxy/CDN na frente (Render, Fly, Nginx, Cloudflare): usa X-Forwarded-For.
TRUST_PROXY=1
# Cookie só em HTTPS. Em produção deixe 1.
SECURE_COOKIE=1
# Validade da sessão (dias) e intervalo de backup (horas).
SESSION_DAYS=30
BACKUP_HOURS=6
# Endereço público com https (obrigatório para ligar o dinheiro real e para o webhook do Pix).
PUBLIC_ORIGIN=

# ---------- Economia de dinheiro real (Gemas) e Mercado de Jogadores ----------
# Desligado por padrão. Só ligue com provedor de pagamento, termos revisados e suporte ativo.
RMT_ENABLED=0
# Defesas do dinheiro real (padrões rigorosos; ver docs/ECONOMIA.md):
# WITHDRAW_EARNED_ONLY=1 WITHDRAW_MIN_ACCOUNT_DAYS=30 WITHDRAW_MIN_LEVEL=30 WITHDRAW_MIN_PLAY_HOURS=20 PIX_REQUIRE_CPF=1
# MARKET_PRICE_BAND_X=5 MARKET_PRICE_FLOOR_X=0.25 MARKET_RESALE_LOCK_DAYS=7 MARKET_NEW_BUYER_HOLD_DAYS=7 MARKET_NEW_BUYER_ACCOUNT_DAYS=30
# Provedor Pix: mercadopago (produção) ou dev (credita na hora; bloqueado em produção).
PAYMENT_PROVIDER=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Token do painel /admin/ (economia e saques). Mínimo de 32 caracteres aleatórios; mais curto desliga o painel.
ADMIN_TOKEN=
WITHDRAWALS_ENABLED=1
# Taxas em pontos-base (500 = 5%) e limites em centavos (100 Gemas = R$ 1,00).
MARKET_FEE_BPS=500
WITHDRAW_FEE_BPS=200
WITHDRAW_MIN_FEE=100
MIN_DEPOSIT=500
MAX_DEPOSIT=100000
MIN_WITHDRAW=2000
MAX_WITHDRAW_DAY=500000
MARKET_MIN_PRICE=10
MARKET_MAX_PRICE=5000000
# Antifraude: horas que um item precisa estar no save do servidor antes de ser vendido e idade mínima da conta.
MARKET_MIN_ITEM_AGE_HOURS=24
MARKET_MIN_ACCOUNT_DAYS=3
MARKET_LISTING_DAYS=14
# Controles do dinheiro real: horas que as vendas ficam retidas antes do saque, bloqueio de compra entre
# contas da mesma rede (IP público), alerta de preço N× acima da mediana e alerta de pares com muitas trocas na semana.
MARKET_HOLD_HOURS=72
MARKET_BLOCK_SAME_NETWORK=1
MARKET_OUTLIER_X=10
MARKET_PAIR_TRADES_WEEK=3

# ---------- Mercado em ouro (sem dinheiro real, sempre disponível) ----------
GOLD_MARKET_ENABLED=1
# Imposto sobre a venda e taxa de anúncio (pontos-base; ambos saem da economia e seguram a inflação).
GOLD_MARKET_TAX_BPS=500
GOLD_MARKET_LIST_FEE_BPS=100
GOLD_MARKET_LIST_FEE_MIN=50
GOLD_MARKET_MIN_PRICE=100
GOLD_MARKET_MIN_ITEM_AGE_HOURS=1
